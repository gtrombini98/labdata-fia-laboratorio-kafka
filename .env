
# Kafka, ZooKeeper e Kafka Connect
CONFLUENT_VERSION=7.6.1

# PostgreSQL do laboratório
POSTGRES_DEBEZIUM=3.0

# Interface visual opcional
AKHQ_VERSION=0.20.0

# pgAdmin
PAGADMIN_VERSION=9.0

# MinIO e cliente MinIO
MINIO_VERSION=RELEASE.2025-02-28T09-55-16Z
MINIO_MC_VERSION=RELEASE.2025-04-08T15-39-49Z

# Plugins do Kafka Connect
S3_SINK_VERSION=10.5.7
DEBEZIUM_CONNECTOR_VERSION=2.5.4

# Memória da JVM, caso o Compose utilize estas variáveis
KAFKA_BROKER_HEAP_OPTS="-XX:MaxRAMPercentage=70.0"
KAFKA_CONNECT_HEAP_OPTS="-XX:MaxRAMPercentage=70.0"
KAFKA_BROKER_MEM_LIMIT=512m
KAFKA_CONNECT_MEM_LIMIT=512m
